#!/usr/bin/env bash
# webfetch — fetch a URL and print it as readable text.
#
#   webfetch https://systemd.io/DEBUGGING/
#   webfetch -c 40000 https://docs.docker.com/engine/install/debian/
#
# Sends the headers a normal desktop browser sends, follows redirects, and
# strips the page down to text a model can actually read. Script, style, nav
# and footer chrome are dropped.
set -euo pipefail

MAX_CHARS=20000
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36'

usage() {
  cat >&2 <<'EOF'
usage: webfetch [-c MAX_CHARS] [-r] URL
  -c MAX_CHARS   truncate output (default 20000)
  -r             raw: print the body without converting to text
EOF
  exit 2
}

RAW=0
while getopts ':c:rh' opt; do
  case "$opt" in
    c) MAX_CHARS="$OPTARG" ;;
    r) RAW=1 ;;
    h) usage ;;
    *) usage ;;
  esac
done
shift $(( OPTIND - 1 ))

URL="${1:-}"
[ -n "$URL" ] || usage
case "$URL" in
  http://*|https://*) ;;
  *) URL="https://${URL}" ;;
esac
case "$MAX_CHARS" in ''|*[!0-9]*) MAX_CHARS=20000 ;; esac
# 10# forces base 10, so -c 020 is twenty rather than octal sixteen.
MAX_CHARS=$((10#$MAX_CHARS))

# A non-newline sentinel keeps command substitution from stripping trailing
# newlines. Preserve the command's status as well as its exact output.
capture() {
  local status=0
  "$@" || status=$?
  printf '.'
  return "$status"
}

body=$(capture curl -sSL --max-time 30 --compressed --max-redirs 5 \
  -A "$UA" \
  -H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8' \
  -H 'Accept-Language: en-US,en;q=0.9' \
  -H 'Upgrade-Insecure-Requests: 1' \
  -H 'Sec-Fetch-Dest: document' \
  -H 'Sec-Fetch-Mode: navigate' \
  -H 'Sec-Fetch-Site: none' \
  -H 'Sec-Fetch-User: ?1' \
  "$URL" 2>/dev/null) || { printf 'webfetch: request failed for %s\n' "$URL" >&2; exit 1; }

body=${body%.}
[ -n "$body" ] || { printf 'webfetch: empty response from %s\n' "$URL" >&2; exit 1; }

if [ "$RAW" -eq 1 ]; then
  # head closes the pipe once it has the cap and kills the writer; fed from
  # a process substitution that death is never a checked status, so an
  # oversized raw fetch still exits 0. The writer's stderr is silenced too:
  # when SIGPIPE is ignored up the process tree (a supervisor that ignores it
  # passes that to every child, and bash never resets an inherited ignore),
  # the write fails with EPIPE and bash reports "write error: Broken pipe"
  # here — noise on stderr for a fetch that succeeded.
  head -c "$MAX_CHARS" < <(printf '%s' "$body" 2>/dev/null)
  exit 0
fi

printf '# %s\n\n' "$URL"

# Prefer a real text browser when the user has one; it renders tables and lists
# far better than any regex. Every branch consumes the FULL conversion: piping
# a converter into head under pipefail turns a successful oversized fetch into
# exit 141 (SIGPIPE), which set -e reports as a failure. Python caps characters
# itself; the other branches cap the captured text below.
status=0
python_capped=0
if command -v w3m >/dev/null 2>&1; then
  text=$(printf '%s' "$body" | capture w3m -dump -T text/html 2>/dev/null) || status=$?
elif command -v lynx >/dev/null 2>&1; then
  text=$(printf '%s' "$body" | capture lynx -stdin -dump -nolist 2>/dev/null) || status=$?
elif command -v python3 >/dev/null 2>&1; then
  python_capped=1
  text=$(printf '%s' "$body" | capture python3 -c '
import html as H, re, sys
raw = sys.stdin.read()
# NULs would make bash command substitution warn and drop bytes.
raw = raw.replace("\x00", "")

# Drop everything that is not prose.
for tag in ("script", "style", "noscript", "svg", "head", "nav", "footer", "form"):
    raw = re.sub(rf"<{tag}\b.*?</{tag}>", " ", raw, flags=re.S | re.I)

# Keep document structure the model can navigate by.
raw = re.sub(r"<h([1-6])[^>]*>(.*?)</h\1>",
             lambda m: "\n\n" + "#" * int(m.group(1)) + " " + m.group(2) + "\n", raw, flags=re.S | re.I)
raw = re.sub(r"<li[^>]*>", "\n- ", raw, flags=re.I)
raw = re.sub(r"<(br|/p|/div|/tr|/section)[^>]*>", "\n", raw, flags=re.I)
raw = re.sub(r"</(pre|code)>", "\n", raw, flags=re.I)

raw = re.sub(r"<[^>]+>", " ", raw)
raw = H.unescape(raw)
raw = re.sub(r"[ \t\xa0]+", " ", raw)
raw = re.sub(r" *\n *", "\n", raw)
raw = re.sub(r"\n{3,}", "\n\n", raw).strip()

# Keep Python character slicing: Bash under LC_ALL=C would split UTF-8 bytes.
limit = int(sys.argv[1])
print(raw[:limit])
if len(raw) > limit:
    print(f"\n… truncated at {limit} chars of {len(raw)}. Re-run with -c to read more.")
' "$MAX_CHARS") || status=$?
else
  text=$(printf '%s' "$body" \
    | sed -e 's/<script[^>]*>.*<\/script>//gI' \
          -e 's/<style[^>]*>.*<\/style>//gI' \
          -e 's/<[^>]*>/ /g' \
    | capture tr -s ' \n' ' \n') || status=$?
fi

if [ "$status" -ne 0 ]; then
  printf 'webfetch: conversion failed for %s\n' "$URL" >&2
  exit 1
fi

text=${text%.}
# Python has already capped Unicode characters, independently of shell locale.
if [ "$python_capped" -eq 1 ]; then
  printf '%s' "$text"
  exit 0
fi

# Cap the exact converter output before adding presentation separators. Short
# output (including an exact-limit result) is emitted byte for byte.
len=${#text}
if [ "$len" -gt "$MAX_CHARS" ]; then
  printf '%s\n' "${text:0:$MAX_CHARS}"
  printf '\n… truncated at %s chars of %s. Re-run with -c to read more.\n' "$MAX_CHARS" "$len"
else
  printf '%s' "$text"
fi
