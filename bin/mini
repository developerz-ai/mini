#!/usr/bin/env bash
# mini — a local AI agent for setting up and debugging Linux boxes.
#
#   mini                 open the agent in the current directory
#   mini "why is X down"  ask one question, get an answer, exit
#
# Wraps opencode + ollama. No cloud account, no API key, no subscription.
set -euo pipefail

MINI_VERSION='0.1.0'

# Resolve our own install root, following symlinks (~/.local/bin/mini -> here).
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case "$_self" in /*) ;; *) _self="${_dir}/${_self}" ;; esac
done
MINI_ROOT=$(cd -P "$(dirname "$_self")/.." && pwd)
MINI_LIB="${MINI_ROOT}/lib"
MINI_SHARE="${MINI_ROOT}/share"
MINI_PLATFORMS="${MINI_ROOT}/platforms"

# Runtime state. Override MINI_HOME to keep it somewhere backed up.
MINI_HOME="${MINI_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/mini}"

export MINI_ROOT MINI_LIB MINI_SHARE MINI_PLATFORMS MINI_HOME MINI_VERSION

# shellcheck source=lib/common.sh
. "${MINI_LIB}/common.sh"
. "${MINI_LIB}/detect.sh"
. "${MINI_LIB}/models.sh"
. "${MINI_LIB}/ollama.sh"
. "${MINI_LIB}/opencode.sh"
. "${MINI_LIB}/doctor.sh"

load_platform() {
  detect_os
  local mod="${MINI_PLATFORMS}/${OS_PLATFORM}.sh"
  if [ -f "$mod" ]; then
    # shellcheck source=platforms/debian.sh
    . "$mod"
  else
    . "${MINI_PLATFORMS}/debian.sh"
    die "unsupported distro: ${OS_NAME}. mini targets the debian family today — see ${MINI_PLATFORMS}/README.md"
  fi
}

usage() {
  cat <<EOF
${C_BOLD}mini${C_RESET} ${MINI_VERSION} — a local AI agent for your Linux box

${C_BOLD}USE${C_RESET}
  mini                        open the agent here (interactive)
  mini "<question or task>"   one shot, then exit
  mini -c                     continue the last session

${C_BOLD}COMMANDS${C_RESET}
  setup            install/repair everything, pick a model
  doctor           check the install and say what to fix
  sudo             enable passwordless sudo so the agent can actually act
  remote [url model [key]]
                   use an external OpenAI-compatible endpoint instead of local
  local            switch back to the local model
  models           list models, what fits this box, what is pulled
  model <id|auto>  switch model (pulls it, rebuilds the context variant)
  remember <text>  save a durable fact about this machine
  memories         show what mini remembers
  serve [--local]  start the ollama server (--local rebinds it to loopback)
  stop             stop the ollama server mini started
  web [--lan]      browser UI, loopback + generated password
  headless [--lan] headless server to attach to, same auth
  password         show the generated server password
  status           one-line health check
  config           print the active configuration
  update           update opencode, ollama and the model
  version | help

${C_BOLD}FLAGS${C_RESET}
  --safe           ask before each action (default is auto-approve)
  --model <id>     use a different model for this run only

${C_BOLD}EXAMPLES${C_RESET}
  mini "install docker and add me to the docker group"
  mini "nginx returns 502, find out why"
  mini "what is eating my disk"
  mini --safe "remove old kernels"

State lives in ${MINI_HOME}
EOF
}

# ---------------------------------------------------------------- setup ----

cmd_setup() {
  load_platform
  detect_all

  step "mini setup"
  detect_summary

  platform_supported || die "mini supports the debian family today; this is ${OS_NAME}"

  step "Dependencies"
  platform_bootstrap

  if ! has ollama; then
    info "installing ollama"
    curl -fsSL https://ollama.com/install.sh | sh || die "ollama install failed"
  fi
  ok "ollama present"

  if ! opencode_bin >/dev/null 2>&1; then
    info "installing opencode"
    curl -fsSL https://opencode.ai/install | bash || die "opencode install failed"
  fi
  ok "opencode present"

  ollama_start
  ollama_tune

  step "Model"
  local base ctx variant
  base="${MINI_FORCE_MODEL:-}"
  [ -n "$base" ] || base=$(models_choose)
  models_known "$base" || warn "'${base}' is not in the registry — trying it anyway"

  ctx=$(models_pick_ctx "$base")
  variant=$(models_ensure "$base" "$ctx" | tail -n1)

  cfg_set MINI_BASE_MODEL "$base"
  cfg_set MINI_MODEL "$variant"
  cfg_set MINI_CTX "$ctx"

  step "Brain"
  install_state_files
  opencode_write_config "$variant" "$ctx"

  say ''
  ok "${C_BOLD}ready${C_RESET} — run ${C_BOLD}mini${C_RESET} in any directory"
  dim "  try: mini \"what is wrong with this machine\""

  if [ "${ACCEL:-cpu}" = 'cpu' ]; then
    say ''
    warn "no GPU here, so inference is on CPU"
    dim "  The first turn of a session spends minutes processing the prompt;"
    dim "  later turns are quicker. If that is too slow, keep everything else"
    dim "  and move only inference off the box:"
    dim "    mini remote https://openrouter.ai/api/v1 <model> <api-key>"
  fi
}

# Copy AGENTS.md, tools and the host memory into MINI_HOME. Never clobbers a
# user-edited AGENTS.md — that file is theirs once they touch it.
install_state_files() {
  ensure_dir "$MINI_HOME"
  ensure_dir "${MINI_HOME}/memories"
  ensure_dir "${MINI_HOME}/tools"
  ensure_dir "${MINI_HOME}/logs"

  compose_agents_md

  for t in websearch webfetch sysreport; do
    install -m 0755 "${MINI_SHARE}/tools/${t}" "${MINI_HOME}/tools/${t}"
  done
  ok "installed shell tools: websearch webfetch sysreport"

  install_opencode_tools

  write_host_memory
}

# opencode only loads custom tools from ~/.config/opencode/tools (global) or a
# project's .opencode/tools. mini uses the global dir — but every tool is
# namespaced mini_*, so nothing shadows an opencode built-in and your other
# projects behave exactly as they did before.
install_opencode_tools() {
  local dst="${HOME}/.config/opencode/tools"
  ensure_dir "$dst"
  local n=0
  for f in "${MINI_SHARE}"/opencode-tools/*.ts; do
    [ -f "$f" ] || continue
    install -m 0644 "$f" "${dst}/$(basename "$f")"
    n=$(( n + 1 ))
  done
  ok "installed ${n} opencode tools → ${dst}"
  dim "  mini_search  mini_fetch  mini_sysreport"
}

# The agent's brain: a platform-neutral base plus the module for this distro.
# Composed rather than shipped whole so adding a platform means adding one
# prompt file, not forking the whole thing.
compose_agents_md() {
  local out="${MINI_HOME}/AGENTS.md"
  local base="${MINI_SHARE}/prompts/base.md"
  local plat="${MINI_SHARE}/prompts/${OS_PLATFORM}.md"
  local tmp="${out}.tmp.$$"

  [ -f "$base" ] || die "missing prompt: $base"

  {
    cat "$base"
    if [ -f "$plat" ]; then
      printf '\n---\n\n'
      cat "$plat"
    fi
  } > "$tmp"

  if [ -f "$out" ] && ! cmp -s "$out" "$tmp"; then
    # A user who edited the brain gets to keep it.
    if [ -f "${MINI_HOME}/.agents-md-generated" ] && cmp -s "$out" "${MINI_HOME}/.agents-md-generated"; then
      mv "$tmp" "$out"
      cp "$out" "${MINI_HOME}/.agents-md-generated"
      ok "updated AGENTS.md (base + ${OS_PLATFORM})"
      return 0
    fi
    mv "$tmp" "${out}.new"
    warn "kept your edited AGENTS.md — new version saved as AGENTS.md.new"
    return 0
  fi

  mv "$tmp" "$out"
  cp "$out" "${MINI_HOME}/.agents-md-generated"
  ok "installed AGENTS.md (base + ${OS_PLATFORM})"
}

# Facts about this machine, refreshed on every setup. This is what lets a 7B
# model skip the "what distro is this" round trip and just act.
write_host_memory() {
  local f="${MINI_HOME}/memories/00-host.md"
  local gpu="none"
  [ -n "${GPU_NAME:-}" ] && gpu="${GPU_NAME}"
  [ "${VRAM_MB:-0}" -gt 0 ] && gpu="${GPU_NAME} (${VRAM_MB} MB VRAM)"

  cat > "$f" <<EOF
# This machine

Written by \`mini setup\` on $(date -u '+%Y-%m-%d'). Facts, not preferences.

- Hostname: $(hostname)
- OS: ${OS_NAME} (id \`${OS_ID}\`, version \`${OS_VERSION}\`)
- Package manager: apt (debian family)
- Init: $( [ -d /run/systemd/system ] && echo systemd || echo 'not systemd' )
- Shell: ${SHELL:-/bin/bash}
- CPU: ${CPU_CORES} cores
- RAM: ${RAM_MB} MB
- GPU: ${gpu}
- Disk free in \$HOME: ${DISK_FREE_GB} GB
- User: $(id -un) (uid $(id -u))
- Root access: $(case "${SUDO_MODE:-}" in
    root) echo 'running as root — no sudo needed' ;;
    nopasswd) echo 'passwordless sudo works — use `sudo -n` freely' ;;
    password) echo 'sudo needs a password, which you CANNOT supply. Do not run bare `sudo` — it will fail with no tty. Print the command and ask the user to run it, or suggest `mini sudo`.' ;;
    none) echo 'no sudo on this box. You cannot install or configure anything system-wide — say so instead of trying.' ;;
    *) echo 'unknown' ;;
  esac)
- Container: $( [ -f /.dockerenv ] && echo yes || echo 'no (or not detectable)' )
EOF
  ok "wrote host memory"
}

# --------------------------------------------------------------- others ----

cmd_model() {
  local want="${1:-}"
  [ -n "$want" ] || die "usage: mini model <id|auto>   (see: mini models)"
  detect_all
  [ "$want" = 'auto' ] && want=$(models_recommend)

  models_known "$want" || warn "'${want}' is not in the registry — trying it anyway"
  ollama_start

  local ctx variant
  ctx=$(models_pick_ctx "$want")
  variant=$(models_ensure "$want" "$ctx" | tail -n1)

  cfg_set MINI_BASE_MODEL "$want"
  cfg_set MINI_MODEL "$variant"
  cfg_set MINI_CTX "$ctx"
  opencode_write_config "$variant" "$ctx"
  ok "now using ${C_BOLD}${want}${C_RESET} at ${ctx} context"
}

# opencode runs bash non-interactively. A sudo that wants a password has no tty
# to ask on, so it does not prompt — it fails or hangs. Either the user has
# passwordless sudo, or the agent simply cannot install anything.
cmd_sudo() {
  detect_all
  local user; user=$(id -un)
  local file="/etc/sudoers.d/90-mini-${user}"

  case "$SUDO_MODE" in
    root)
      ok "running as root — nothing to do"; return 0 ;;
    nopasswd)
      ok "passwordless sudo already works — the agent can install packages"; return 0 ;;
    none)
      err "sudo is not installed on this box"
      dim "  install it as root:  apt-get install -y sudo && usermod -aG sudo ${user}"
      return 1 ;;
  esac

  step "Passwordless sudo for ${user}"
  say "  opencode runs commands without a terminal, so ${C_BOLD}sudo cannot ask you"
  say "  for a password${C_RESET}. Without this, the agent can read the machine but"
  say "  cannot install, configure or fix anything on it."
  say ''
  warn "This grants ${user} full root access with no password."
  dim "  Right for a dev box, a VPS you own, or a VM you can rebuild."
  dim "  Wrong for a shared or production machine — use 'mini --safe' and run"
  dim "  privileged commands yourself instead."
  say ''

  confirm "Write ${file}?" 'n' || { say 'nothing changed'; return 1; }

  local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/mini-sudoers.XXXXXX")
  printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$user" > "$tmp"
  chmod 0440 "$tmp"

  # A malformed sudoers file locks everyone out of root. Validate first.
  if has visudo && ! visudo -c -f "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"; die "generated sudoers file failed validation — nothing written"
  fi

  info "this is the one time you will be asked for your password"
  if sudo install -m 0440 -o root -g root "$tmp" "$file"; then
    rm -f "$tmp"
    if sudo -n true 2>/dev/null; then
      ok "passwordless sudo enabled — the agent can now do its job"
      detect_sudo
      write_host_memory
    else
      warn "wrote ${file} but sudo still prompts — check /etc/sudoers includes sudoers.d"
    fi
  else
    rm -f "$tmp"; die "could not write ${file}"
  fi

  dim "  undo with:  sudo rm ${file}"
}

# Point mini at someone else's GPU.
#
# Any OpenAI-compatible endpoint. Everything that makes mini useful — the brain,
# the tools, the memory, the slash commands — is unchanged; only inference moves
# off this box. This is the right answer for a machine that cannot run a model
# at a tolerable speed, which is most machines without a GPU.
cmd_remote() {
  detect_all

  # Non-interactive form:  mini remote <url> <model> [api-key]
  # Handy for cloud-init and for anyone who already knows what they want.
  if [ "$#" -ge 2 ]; then
    local r_url="$1" r_model="$2" r_key="${3:-}" r_ctx
    r_ctx=$(cfg_get MINI_CTX); [ -n "$r_ctx" ] || r_ctx=131072
    ensure_dir "$MINI_HOME"
    ( umask 077; printf '%s\n' "$r_key" > "${MINI_HOME}/api-key" )
    chmod 600 "${MINI_HOME}/api-key"
    cfg_set MINI_PROVIDER remote
    cfg_set MINI_REMOTE_URL "$r_url"
    cfg_set MINI_REMOTE_MODEL "$r_model"
    cfg_set MINI_CTX "$r_ctx"
    install_state_files
    opencode_write_config "$r_model" "$r_ctx"
    ok "using ${C_BOLD}${r_model}${C_RESET} via ${r_url}"
    return 0
  fi

  step "External inference"
  say "  Any OpenAI-compatible endpoint: OpenRouter, Groq, Together, DeepInfra,"
  say "  a vLLM server on your LAN, or another machine's ollama."
  say ''
  dim "  OpenRouter   https://openrouter.ai/api/v1"
  dim "  Groq         https://api.groq.com/openai/v1"
  dim "  Together     https://api.together.xyz/v1"
  dim "  remote box   http://192.168.1.10:11434/v1"
  say ''

  local url model key ctx
  url=$(ask "API base URL (must end in /v1)" "$(cfg_get MINI_REMOTE_URL)")
  [ -n "$url" ] || die "no URL given"

  model=$(ask "model id" "$(cfg_get MINI_REMOTE_MODEL)")
  [ -n "$model" ] || die "no model given"

  ctx=$(ask "context window" "131072")

  say ''
  if [ "${MINI_YES:-0}" = "1" ]; then
    # Unattended: never block on stdin for a secret. An empty key is the
    # same thing the 2-argument form stores when no key is given.
    key=''
    dim "  MINI_YES=1 — no API key was read, an empty key was stored"
  else
    say "  API key — leave empty for an endpoint that does not need one"
    printf '%s' "${C_CYAN}?${C_RESET} key: " >&2
    if [ -t 0 ]; then
      read -rs key || key=''
      printf '\n' >&2
    else
      read -r key || key=''
    fi
  fi

  ensure_dir "$MINI_HOME"
  ( umask 077; printf '%s\n' "$key" > "${MINI_HOME}/api-key" )
  chmod 600 "${MINI_HOME}/api-key"

  cfg_set MINI_PROVIDER remote
  cfg_set MINI_REMOTE_URL "$url"
  cfg_set MINI_REMOTE_MODEL "$model"
  cfg_set MINI_CTX "$ctx"

  install_state_files
  opencode_write_config "$model" "$ctx"

  say ''
  ok "using ${C_BOLD}${model}${C_RESET} via ${url}"
  dim "  key stored 0600 in ${MINI_HOME}/api-key"
  dim "  back to local anytime:  mini local"
}

# Return to the local model.
cmd_local() {
  detect_all
  local base; base=$(cfg_get MINI_BASE_MODEL)
  cfg_set MINI_PROVIDER local
  if [ -z "$base" ]; then
    warn "no local model set up yet"
    cmd_setup
    return $?
  fi
  ollama_start
  local ctx variant
  ctx=$(models_pick_ctx "$base")
  variant=$(models_ensure "$base" "$ctx" | tail -n1)
  cfg_set MINI_MODEL "$variant"
  cfg_set MINI_CTX "$ctx"
  opencode_write_config "$variant" "$ctx"
  ok "back to local: ${C_BOLD}${base}${C_RESET}"
}

cmd_remember() {
  local text="$*"
  [ -n "$text" ] || die "usage: mini remember \"postgres runs in docker on port 5433\""
  ensure_dir "${MINI_HOME}/memories"
  local f="${MINI_HOME}/memories/10-learned.md"
  [ -f "$f" ] || printf '# Learned about this machine\n\nFacts mini was told to remember.\n\n' > "$f"
  printf -- '- %s _(%s)_\n' "$text" "$(date -u '+%Y-%m-%d')" >> "$f"
  ok "remembered"
  dim "  $f"
}

cmd_memories() {
  local dir="${MINI_HOME}/memories"
  [ -d "$dir" ] || die "no memories yet — run: mini setup"
  local found=0
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    found=1
    step "$(basename "$f")"
    cat "$f"
  done
  [ "$found" -eq 1 ] || dim "nothing remembered yet"
}

cmd_config() {
  step "mini ${MINI_VERSION}"
  printf '  %-16s %s\n' 'install root' "$MINI_ROOT"
  printf '  %-16s %s\n' 'state' "$MINI_HOME"
  printf '  %-16s %s\n' 'base model' "$(cfg_get MINI_BASE_MODEL)"
  printf '  %-16s %s\n' 'runtime model' "$(cfg_get MINI_MODEL)"
  printf '  %-16s %s\n' 'context' "$(cfg_get MINI_CTX)"
  printf '  %-16s %s\n' 'ollama' "$OLLAMA_URL"
  printf '  %-16s %s\n' 'opencode cfg' "${MINI_HOME}/opencode.json"
  printf '  %-16s %s\n' 'approvals' "$( [ "${MINI_SAFE:-0}" = '1' ] && echo 'ask (--safe)' || echo 'auto-approved' )"
}

cmd_status() {
  detect_all
  local model; model=$(cfg_get MINI_MODEL)
  if ollama_up; then
    ok "mini ready — ${model:-no model} @ ${OLLAMA_URL}"
  else
    warn "ollama down — run: mini serve"
    return 1
  fi
}

cmd_update() {
  load_platform
  detect_all
  step "Updating"
  if opencode_bin >/dev/null 2>&1; then
    info "opencode"
    "$(opencode_bin)" upgrade || warn "opencode upgrade failed"
  fi
  info "ollama"
  curl -fsSL https://ollama.com/install.sh | sh || warn "ollama update failed"
  local base; base=$(cfg_get MINI_BASE_MODEL)
  if [ -n "$base" ]; then
    info "model ${base}"
    ollama_start
    ollama pull "$base" || warn "model pull failed"
    local ctx variant
    ctx=$(models_pick_ctx "$base")
    variant=$(models_ensure "$base" "$ctx" | tail -n1)
    opencode_write_config "$variant" "$ctx"
  fi
  install_state_files
  ok "up to date"
}

# Everything the agent does needs a live server and a configured model.
ensure_ready() {
  [ -f "${MINI_HOME}/opencode.json" ] || die "mini is not set up yet — run: mini setup"
  # Remote inference needs no local server.
  [ "$(cfg_get MINI_PROVIDER)" = 'remote' ] && return 0
  ollama_up || ollama_start
}

# ------------------------------------------------------------- dispatch ----

main() {
  local -a passthru=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --safe)  MINI_SAFE=1; export MINI_SAFE; shift ;;
      --model) MINI_FORCE_MODEL="${2:-}"; export MINI_FORCE_MODEL; shift 2 ;;
      --yes|-y) MINI_YES=1; export MINI_YES; shift ;;
      *) break ;;
    esac
  done

  local cmd="${1:-}"
  case "$cmd" in
    setup)     shift; cmd_setup "$@" ;;
    doctor)    shift; doctor_run ;;
    models)    shift; detect_all; models_list "${1:-}" ;;
    model)     shift; cmd_model "${1:-}" ;;
    sudo)      shift; cmd_sudo ;;
    remote)    shift; cmd_remote "$@" ;;
    local)     shift; cmd_local ;;
    remember)  shift; cmd_remember "$@" ;;
    memories)  shift; cmd_memories ;;
    serve)     shift
               detect_sudo
               if [ "${1:-}" = '--local' ]; then ollama_bind_local; fi
               ollama_start; ollama_tune; ollama_status ;;
    stop)      shift; ollama_stop ;;
    web)       shift; ensure_ready; opencode_web web "$@" ;;
    headless)  shift; ensure_ready; opencode_web serve "$@" ;;
    password)  shift; say "user: opencode"; say "pass: $(mini_secret)" ;;
    status)    shift; cmd_status ;;
    config)    shift; cmd_config ;;
    update)    shift; cmd_update ;;
    version|--version|-v) say "mini ${MINI_VERSION}" ;;
    help|--help|-h) usage ;;
    '')        ensure_ready; opencode_launch ;;
    -c|--continue)
               shift; ensure_ready; opencode_launch -c "$@" ;;
    run)       shift; ensure_ready; opencode_run "$@" ;;
    -*)        ensure_ready; opencode_launch "$@" ;;
    *)         # Anything else is a prompt: mini "why is nginx down"
               ensure_ready
               passthru=("$@")
               opencode_run "${passthru[@]}" ;;
  esac
}

main "$@"
